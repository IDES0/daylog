TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=      # numeric Telegram user id — REQUIRED
ANTHROPIC_API_KEY=
VAULT_PATH=../daylog-vault
BRIEF_HOUR=7
TZ=Asia/Makassar
# The journal day ends here, not at midnight; the end-of-day reconcile runs just after.
DAY_CUTOFF_HOUR=4

# API spend caps (USD). Journaling never stops; optional research/planning/chat
# web searches pause for the month once MONTHLY_BUDGET_USD is reached.
MONTHLY_BUDGET_USD=40
RESEARCH_RUN_BUDGET_USD=1.50

# Optional: serves a read-only calendar feed at /calendar/<secret>.ics for
# Google/Apple Calendar to subscribe to. Leave unset to disable — the
# server simply won't start. Generate a real secret, e.g. `openssl rand -hex 16`.
CALENDAR_FEED_SECRET=
# PORT is injected by Railway; only set this yourself for local testing.
PORT=8080
# Weekly review (Sunday) hour; set WEEKLY_PLAN=0 to skip the plan that follows it.
REVIEW_HOUR=20
WEEKLY_PLAN=1
